{
  "appId": "com.tablepet.runtime",
  "productName": "TablePet",
  "directories": {
    "buildResources": "assets",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "pets",
      "to": "pets",
      "filter": [
        "**/*",
        "!**/.DS_Store"
      ]
    }
  ],
  "mac": {
    "icon": "assets/icons/app-icon.icns",
    "target": ["dmg"],
    "category": "public.app-category.utilities"
  },
  "win": {
    "icon": "assets/icons/app-icon.ico",
    "target": ["nsis"]
  }
}
